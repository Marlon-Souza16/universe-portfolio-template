{
  "name": "vector-space-portfolio",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "rm -rf .test-dist && tsc -p tsconfig.navigation-test.json && for suite in .test-dist/src/lib/*.test.js .test-dist/src/store/*.test.js; do node \"$suite\" || exit; done && npm run test:images",
    "typecheck": "tsc --noEmit",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test:images": "node --test scripts/optimize-images.test.mjs",
    "validate:content": "npm test"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
